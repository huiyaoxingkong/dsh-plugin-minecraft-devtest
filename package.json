{
  "name": "minecraft-devtest",
  "version": "0.4.0",
  "description": "Client-free Minecraft mod and datapack development harness for DeepSeek Harness (DSH): headless server control across 1.7.10–26.4, RCON assertions, datapack validation/deploy/reload, Mineflayer and built-in legacy/26.x protocol bots, deterministic YAML test cards and one-call quick checks.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "scripts/**/*.mjs",
    "vendor/**/*",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/**",
    "examples/**"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "minecraft",
    "minecraft-modding",
    "minecraft-server",
    "datapack",
    "mineflayer",
    "rcon",
    "mod-loader",
    "fabric",
    "forge",
    "neoforge",
    "quilt",
    "game-test",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiyaoxingkong/minecraft-devtest.git"
  },
  "homepage": "https://github.com/huiyaoxingkong/minecraft-devtest#readme",
  "bugs": {
    "url": "https://github.com/huiyaoxingkong/minecraft-devtest/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "gen:docs": "node scripts/gen-api-docs.mjs",
    "gen:versions": "node scripts/gen-versions.mjs",
    "check": "node --check index.js && node --check lib/server.js && node --check lib/bot.js && node --check lib/datapack.js && node --check lib/protocol-compat.js && node --check lib/legacy-bot.js",
    "test:unit": "node --test --test-concurrency=1 test/cards.test.mjs test/init.test.mjs test/guide.test.mjs test/gradle.test.mjs test/rcon.test.mjs test/bridge.test.mjs test/forge-bridge.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1"
  },
  "dependencies": {
    "minecraft-data": "^3.119.0",
    "minecraft-protocol": "^1.68.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-chunk": "^1.41.0",
    "prismarine-physics": "^1.11.1",
    "prismarine-registry": "^1.12.0"
  }
}
